<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<Pane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.Client.View.GUI.ActiveGamesSceneController">
    <children>
        <ImageView fitHeight="400.0" fitWidth="600.0" pickOnBounds="true">
            <image>
                <Image url="@../img/background.jpg" />
            </image>
        </ImageView>
        <VBox fx:id="activeGamesBox" alignment="CENTER" prefHeight="400.0" prefWidth="600.0" spacing="10" />
        <Text layoutX="155.0" layoutY="41.0" strokeType="OUTSIDE" strokeWidth="0.0" text="These are the current active games">
            <font>
                <Font name="Luminari" size="18.0" />
            </font>
        </Text>
        <Button fx:id="continueButton" blendMode="MULTIPLY" layoutX="506.0" layoutY="354.0" mnemonicParsing="false" onAction="#onContinue" text="Continue">
            <font>
                <Font name="Luminari" size="14.0" />
            </font>
        </Button>
        <Button fx:id="refreshButton" alignment="BOTTOM_LEFT" blendMode="MULTIPLY" onAction="#onRefresh" mnemonicParsing="false" text="Refresh">
            <font>
                <Font name="Luminari" size="14.0" />
            </font>
        </Button>
    </children>
</Pane>
